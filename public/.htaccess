# One address for the whole site, and old addresses sent to their current pages.
ErrorDocument 404 /404.html
AddType text/vtt .vtt

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.peakleads\.agency$ [NC]
RewriteRule ^(.*)$ https://peakleads.agency/$1 [R=301,L]

RewriteRule ^about-us/?$ /about/ [R=301,L]
RewriteRule ^contact-us/?$ /contact/ [R=301,L]
RewriteRule ^privacy-policy/?$ /privacy/ [R=301,L]
RewriteRule ^cookie-policy/?$ /privacy/ [R=301,L]
RewriteRule ^free-audit/?$ /book-a-call/ [R=301,L]
</IfModule>

# Pages are checked with the server before a browser reuses them, so a deploy reaches returning visitors on their next visit. Files under /assets/ keep their long cache.
<IfModule mod_headers.c>
# HTTPS only, raised in steps (five minutes, a day, a month, then a year on 12 Nov 2026: T-59's last step). No includeSubDomains or preload until every subdomain is known to answer over https.
Header always set Strict-Transport-Security "max-age=31536000"

# Security headers (12 Nov 2026), the same lines as positionxero.com's on this host. Nothing a visitor sees changes: no sniffing of file types, no framing by other sites, only the domain (not the full address) sent to other sites as the referrer, and no camera, microphone or location access.
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>

# The scripts, stylesheets and fonts Vite builds into /assets/ carry a hash of their content in the name (pixel-CkKjo5nV.css), so a changed file always arrives under a new name and a browser can keep the old one for a year. Pictures, logos and videos keep their names when they are replaced, so they stay on the host's one-week default.
<FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
